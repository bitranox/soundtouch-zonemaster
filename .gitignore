# ====================================
# Python bytecode & caches
# ====================================
# __pycache__: compiled .pyc files at any depth
# *.py[cod]: catches .pyc, .pyo, .pyd
__pycache__/
*.py[cod]
*$py.class     # other compiled artifacts

