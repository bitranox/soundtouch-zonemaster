.pytest_cache/
.mypy_cache/
.pyright/
.coverage*
htmlcov/
nosetests.xml
coverage.xml
coverage.json
*.cover
.hypothesis/
.tox/
.nox/

# general cache directories (any project-level caching)
.cache/
.run/
.import_linter_cache/
.ruff_cache/

