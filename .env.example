# Optional. The hardware tests read their settings from tests/e2e_defaults.d/90-e2e-rnhome.toml
# (copy tests/e2e_defaults.d/90-e2e-rnhome.toml.example), which is where they belong: typed, and
# beside the safe defaults they override. A .env at the repository root (gitignored) is still read
# ABOVE that file, so a key set here wins over it. Everything in a .env is text: the speakers comma
# separated, E2E_AUDIBLE a word. Placeholders only below.

# The host on the speaker LAN that the probe runs on, and how to reach it.
E2E_HOST=
E2E_USER=root
E2E_KEY=/path/to/ssh/key

# The speakers the read-only probe may query, comma separated. List every box in the house.
E2E_SPEAKERS=192.0.2.11,192.0.2.12

# Whether a test may do something AUDIBLE. Leave false unless you know who is at home.
E2E_AUDIBLE=false

# Optional. The PostgreSQL arm of the house-store tests (tests/conftest.py's house_database
# fixture): unset, those tests run against SQLite alone, which is what `make test` does. The URL
# MUST name a THROWAWAY database - every store test drops the house tables in it, before and
# after - and carries no password (the store refuses one in the URL itself); the password is its
# own key below, exported as PGPASSWORD for the test process (only when the URL is the one from
# this file) rather than read from ~/.pgpass. Placeholders only below.
# The tests that log in to the server as the service would - the installed command end to end, and
# a missing or wrong password refused - run only when the URL comes from THIS file with its
# password: a ZONEMASTER_TEST_POSTGRES_URL from the process environment still runs the store tests
# against that server, but skips those, since the suite knows a password only for this file's URL.
ZONEMASTER_TEST_POSTGRES_URL=postgresql+psycopg://db_user@db.example:5432/db_name
ZONEMASTER_TEST_POSTGRES_PASSWORD=
# Informational only: the tests do not read these four. The URL above is what they connect to,
# so keep these in step with it by hand if you keep them at all.
ZONEMASTER_TEST_POSTGRES_HOST=db.example
ZONEMASTER_TEST_POSTGRES_PORT=5432
ZONEMASTER_TEST_POSTGRES_DATABASE=db_name
ZONEMASTER_TEST_POSTGRES_USER=db_user
